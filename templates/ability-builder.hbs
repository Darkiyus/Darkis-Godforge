<section class="dg-builder">
  <header class="dg-builder-toolbar">
    <div><h2>{{ui.BUILDER_TITLE}}</h2><p>{{ui.BUILDER_HINT}}</p></div>
    <div class="dg-builder-actions">
      <button type="button" data-action="undo" {{#unless canUndo}}disabled{{/unless}} title="{{ui.UNDO}}"><i class="fas fa-rotate-left" aria-hidden="true"></i></button>
      <button type="button" data-action="redo" {{#unless canRedo}}disabled{{/unless}} title="{{ui.REDO}}"><i class="fas fa-rotate-right" aria-hidden="true"></i></button>
      <button type="button" data-action="auto-layout"><i class="fas fa-wand-magic-sparkles" aria-hidden="true"></i> {{ui.AUTO_LAYOUT}}</button>
      <button type="button" data-action="zoom-out" title="{{ui.ZOOM_OUT}}"><i class="fas fa-magnifying-glass-minus" aria-hidden="true"></i></button>
      <span class="dg-zoom-value">{{zoomPercent}}%</span>
      <button type="button" data-action="zoom-in" title="{{ui.ZOOM_IN}}"><i class="fas fa-magnifying-glass-plus" aria-hidden="true"></i></button>
      <button type="button" data-action="center-graph" title="{{ui.CENTER_GRAPH}}"><i class="fas fa-crosshairs" aria-hidden="true"></i></button>
      <button type="button" data-action="simulate"><i class="fas fa-flask" aria-hidden="true"></i> {{ui.SIMULATE}}</button>
      <button type="button" class="dg-primary" data-action="save-graph" {{#unless valid}}disabled{{/unless}}><i class="fas fa-floppy-disk" aria-hidden="true"></i> {{ui.SAVE_GRAPH}}</button>
    </div>
  </header>
  <div class="dg-builder-shell">
    <aside class="dg-node-library">
      <h3>{{ui.NODE_LIBRARY}}</h3>
      <input type="search" data-library-search value="{{search}}" placeholder="{{ui.SEARCH_NODES}}">
      <select data-library-category>
        <option value="all">{{ui.ALL}}</option><option value="trigger">{{ui.TRIGGERS}}</option><option value="logic">{{ui.LOGIC}}</option><option value="action">{{ui.ACTIONS}}</option><option value="result">{{ui.RESULTS}}</option>
      </select>
      <details class="dg-graph-templates"><summary>{{ui.TEMPLATES}}</summary>
        <button type="button" data-graph-template="heal">{{ui.TEMPLATE_HEAL}}</button>
        <button type="button" data-graph-template="damage-reaction">{{ui.TEMPLATE_DAMAGE_REACTION}}</button>
        <button type="button" data-graph-template="daily-resource">{{ui.TEMPLATE_DAILY_RESOURCE}}</button>
      </details>
      <div class="dg-node-library-list">
        {{#each library}}<button type="button" data-add-node data-category="{{category}}" data-type="{{type}}" class="category-{{category}}"><i class="fas {{icon}}" aria-hidden="true"></i><span>{{label}}</span><small>{{categoryLabel}}</small></button>{{/each}}
      </div>
    </aside>
    <main class="dg-graph-region">
      {{#if connecting}}<div class="dg-connect-banner"><i class="fas fa-link" aria-hidden="true"></i> {{ui.CONNECT_TARGET}}</div>{{/if}}
      <div class="dg-graph-canvas" style="{{canvasStyle}}" role="application" aria-label="{{ui.GRAPH_CANVAS}}">
        <svg class="dg-graph-edges" width="4000" height="3000" aria-hidden="true">{{#each edges}}<path d="{{path}}" class="port-{{portType}}"></path>{{/each}}</svg>
        {{#each nodes}}
          <article class="dg-graph-node category-{{category}} {{#if selected}}selected{{/if}} {{#if connecting}}connecting{{/if}} {{#if hasError}}invalid{{/if}}" style="{{style}}" data-graph-node="{{id}}" tabindex="0" aria-label="{{category}}: {{label}}">
            <header data-node-drag><i class="fas {{icon}}" aria-hidden="true"></i><strong>{{label}}</strong><small>{{categoryLabel}}</small></header>
            <p>{{type}}</p>
            {{#each inputPorts}}<button type="button" class="dg-node-port input port-{{type}}" style="{{style}}" data-node-port data-node-input="{{port}}" data-port-type="{{type}}" title="{{label}}" aria-label="{{../ui.CONNECT_INPUT}}: {{label}}"><span>{{label}}</span></button>{{/each}}
            {{#each outputPorts}}<button type="button" class="dg-node-port output port-{{type}}" style="{{style}}" data-node-port data-node-output="{{port}}" data-port-type="{{type}}" title="{{label}}" aria-label="{{../ui.CONNECT_OUTPUT}}: {{label}}"><span>{{label}}</span></button>{{/each}}
          </article>
        {{/each}}
        {{#unless nodes.length}}<div class="dg-graph-empty"><i class="fas fa-diagram-project" aria-hidden="true"></i><h3>{{ui.EMPTY_GRAPH}}</h3><p>{{ui.EMPTY_GRAPH_HINT}}</p></div>{{/unless}}
      </div>
      <div class="dg-graph-minimap" aria-hidden="true">{{#each nodes}}<i class="category-{{category}}" style="{{miniStyle}}"></i>{{/each}}</div>
    </main>
    <aside class="dg-node-inspector">
      {{#if selected}}
        <div class="dg-inspector-title"><div><small>{{selectedCategory}}</small><h3>{{selected.label}}</h3></div><span>{{selected.type}}</span></div>
        <div class="dg-inspector-fields">
          {{#each selectedConfig}}
            <label>{{label}}
              {{#if isSelect}}<select data-node-field="{{key}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
              {{else if isTextarea}}<textarea data-node-field="{{key}}" rows="5">{{value}}</textarea>
              {{else}}<input data-node-field="{{key}}" type="{{type}}" value="{{value}}">{{/if}}
            </label>
          {{/each}}
        </div>
        <div class="dg-inspector-actions"><button type="button" data-action="duplicate-node"><i class="fas fa-copy" aria-hidden="true"></i> {{ui.DUPLICATE}}</button><button type="button" class="dg-danger" data-action="delete-node"><i class="fas fa-trash" aria-hidden="true"></i> {{ui.REMOVE}}</button></div>
      {{else}}<div class="dg-inspector-empty"><i class="fas fa-arrow-pointer" aria-hidden="true"></i><h3>{{ui.SELECT_NODE}}</h3><p>{{ui.SELECT_NODE_HINT}}</p></div>{{/if}}
      <details class="dg-graph-outline" open><summary>{{ui.LINEAR_OUTLINE}}</summary><ol>{{#each outline}}<li>{{this}}</li>{{/each}}</ol></details>
    </aside>
  </div>
  <footer class="dg-builder-status">
    <section class="{{#if valid}}valid{{else}}invalid{{/if}}"><h3><i class="fas {{#if valid}}fa-circle-check{{else}}fa-triangle-exclamation{{/if}}" aria-hidden="true"></i> {{#if valid}}{{ui.GRAPH_VALID}}{{else}}{{ui.GRAPH_INVALID}}{{/if}}</h3>{{#if issues.length}}<ul>{{#each issues}}<li>{{message}}</li>{{/each}}</ul>{{/if}}</section>
    {{#if simulation.length}}<section><h3>{{ui.SIMULATION}}</h3><ol>{{#each simulation}}<li>{{this}}</li>{{/each}}</ol></section>{{/if}}
  </footer>
</section>
